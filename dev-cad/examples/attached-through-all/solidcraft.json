{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "width",
        "expression": "80",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "depth",
        "expression": "60",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "thickness",
        "expression": "5",
        "unit": "mm"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": "width",
        "width": "depth",
        "height": "thickness",
        "corner": [
          "-width / 2",
          "-depth / 2",
          0
        ],
        "body_name": "AttachedThroughAll"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "AttachedThroughAll"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "AttachedThroughAll",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Through cut"
      }
    },
    {
      "command": "sketch.line",
      "params": {
        "points": [
          [
            -10,
            -8
          ],
          [
            10,
            -8
          ],
          [
            10,
            8
          ],
          [
            -10,
            8
          ]
        ],
        "closed": true,
        "ids": [
          "a",
          "b",
          "c",
          "d"
        ]
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "AttachedThroughAll"
        ],
        "name": "Through cut",
        "through_all": true,
        "direction": "negative"
      }
    }
  ]
}
