{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "component.create",
      "params": {
        "name": "BossedPanel",
        "grounded": true
      },
      "bind": {
        "$bossedpanel_occurrence_1": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 20,
        "width": 10,
        "height": 4,
        "operation": "new",
        "center": [
          0,
          0,
          0
        ],
        "body_name": "BossedPanel"
      }
    },
    {
      "command": "solid.cylinder",
      "params": {
        "height": 4,
        "diameter": 4,
        "base": [
          6,
          0,
          1.5
        ],
        "axis": "Z",
        "operation": "join",
        "targets": [
          "BossedPanel"
        ]
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "occurrence.copy",
      "params": {
        "component": "BossedPanel"
      },
      "bind": {
        "$bossedpanel_occurrence_2": "occurrence"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$bossedpanel_occurrence_1",
        "translate": [
          -30,
          0,
          0
        ],
        "axis": [
          1.0,
          0.0,
          0.0
        ],
        "angle": "90 deg",
        "move_grounded": true
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$bossedpanel_occurrence_2",
        "translate": [
          30,
          0,
          0
        ],
        "axis": [
          1.0,
          0.0,
          0.0
        ],
        "angle": "90 deg"
      }
    }
  ]
}
